<!-- views/editar.ejs -->
<!DOCTYPE html>
<html lang="es">
  <head><%- include('includes/head.ejs') %></head>
  <body>
    <%- include('includes/nav.ejs') %>
    <section class="section">
      <div class="container">
        <h1 class="title">Editar película</h1>
        
        
        <form action="/peliculas/<%= id %>/edit" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="titulo" class="label">Título</label>
            <div class="control">
              <input id="titulo" name="titulo" class="input" type="text" value="<%= peli.titulo %>">
            </div>
          </div>

          <div class="field">
            <label class="label">Póster actual</label>
            <% if (peli.imagen) { %>
              <figure class="image is-128x128" style="margin-bottom: 0.5rem;">
                <img src="/<%= peli.imagen %>" alt="Póster actual">
              </figure>
            <% } else { %>
              <p class="has-text-grey">Sin imagen</p>
            <% } %>
            <label for="imagen" class="label" style="margin-top: 0.5rem;">Cambiar póster (opcional)</label>
            <div class="control">
              <input id="imagen" name="imagen" class="input" type="file" accept="image/png, image/jpg, image/jpeg">
            </div>
          </div>
          <div class="field">
            <label for="sinopsis" class="label">Sinopsis</label>
            <div class="control">
              <textarea id="sinopsis" name="sinopsis" class="textarea"><%= peli.sinopsis || '' %></textarea>
            </div>
          </div>
          <input class="button is-primary" type="submit" value="Guardar cambios">
          <a href="/cartelera/<%= id %>" class="button is-light">Cancelar</a>
        </form>
      </div>
    </section>
  </body>
</html>