<!-- views/detalle.ejs -->
<!DOCTYPE html>
<html lang="es">
  <head><%- include('includes/head.ejs') %>
    <!-- Leaflet CSS -->  
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </head>
  <body>
    <%- include('includes/nav.ejs') %>
    <section class="section">
      <div class="container">
        <h1 class="title"><%= peli.titulo %></h1>
        <div id="detalle-pelicula"
             data-titulo="<%= peli.titulo %>"
             data-imagen="<%= peli.imagen %>"
             style="cursor:pointer; max-width:300px">
        </div>
        <br>
        <p class="content"><%= peli.sinopsis || '' %></p>
        <br>
        <% if (privilegios.some(p => p.privilegio === 'editar_pelicula')) { %>
          <a href="/peliculas/<%= id %>/edit" class="button is-info mt-4">Editar película</a>
        <% } %>
        <a href="/cartelera" class="button is-warning mt-4">Volver a cartelera</a>

        <div class="mt-6">
          <h2 class="subtitle">Cines cercanos</h2>
          <button id="btn-cines" class="button is-primary mb-4">
            📍 Buscar cines cerca de mí
          </button>
          <p id="mapa-status" class="help mb-2"></p>
          <div id="mapa" style="height: 450px; border-radius: 8px; display:none;"></div>
        </div>

      

      </div>
    </section>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/cines.js"></script>
  </body>
</html>