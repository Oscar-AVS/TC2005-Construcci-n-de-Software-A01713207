<!-- views/login.ejs -->

<!DOCTYPE html>
<html lang="es">
  <head><%- include('includes/head.ejs') %></head>
  <body>
    <%- include('includes/nav.ejs') %>
    <section class="section">
      <div class="container">
        <h1 class="title">Iniciar sesión</h1>
        <form action="/users/login" method="POST">
          <div class="field">
            <label for="username" class="label">Usuario</label>
            <div class="control">
              <input id="username" name="username" class="input" type="text" placeholder="e.g. Oscar" value="<%= lastUser %>" required>
            </div>
          </div>
          <div class="field">
            <label for="password" class="label">Contraseña</label>
            <div class="control">
              <input id="password" name="password" class="input" type="password" required>
            </div>
          </div>
          <input class="button is-primary" type="submit" value="Entrar">
        </form>
      </div>
    </section>
  </body>
</html>